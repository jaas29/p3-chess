{
  // The editor's red underlines come from the Microsoft C/C++ extension (cpptools),
  // not the compiler. Point it at the flags CMake really uses (build/dev), so it
  // knows about -std=c++20 and the include/ folder. A new .cpp file only gets the
  // right flags after it is in CMakeLists.txt and the project has been built once.
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/dev/compile_commands.json",
  "C_Cpp.default.cppStandard": "c++20",

  // Same thing for clangd, in case it is ever installed.
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build/dev",
    "--header-insertion=never"
  ],

  // Two save-related episodes on 21 Sep came from editing without saving, so
  // the file on disk did not match what was on screen.
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000
}
